        <item>
         <layout class="QVBoxLayout" name="about_cycles_layout">
          <property name="spacing">
           <number>6</number>
          </property>
          <item>
           <widget class="QLabel" name="about_cycles_title_label">
            <property name="font">
             <font>
              <bold>true</bold>
             </font>
            </property>
            <property name="text">
             <string>About the sleep cycles</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="about_cycles_label">
            <property name="text">
             <string>Sleep cycles typically last between 90 minutes and 2 hours, during which the brain alternates between slow-wave sleep and REM sleep. A sleep cycle consists of successive NREM–REM periods.</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
            <property name="variant" stdset="0">
             <string notr="true">help</string>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="definitions_layout" stretch="1,1">
            <property name="spacing">
             <number>16</number>
            </property>
            <item>
             <widget class="QLabel" name="nremp_label">
              <property name="text">
               <string>&lt;b&gt;NREM period (NREMP)&lt;/b&gt;&lt;br/&gt;• The first NREMP begins at the first NREM stage of the recording.&lt;br/&gt;• The central NREMPs begin at the next NREM stage following the end of a REMP.&lt;br/&gt;• A NREMP ends at the start of a REMP.</string>
              </property>
              <property name="textFormat">
               <enum>Qt::TextFormat::RichText</enum>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="variant" stdset="0">
               <string notr="true">help</string>
              </property>
              <property name="alignment">
               <set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignTop</set>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="remp_label">
              <property name="text">
               <string>&lt;b&gt;REM period (REMP)&lt;/b&gt;&lt;br/&gt;• A REMP begins at the first R stage.&lt;br/&gt;• It ends when there are 15 min without an R stage (except in the last cycle).&lt;br/&gt;• Its end is the last R stage of the REMP, or the beginning of the next NREMP.</string>
              </property>
              <property name="textFormat">
               <enum>Qt::TextFormat::RichText</enum>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="variant" stdset="0">
               <string notr="true">help</string>
              </property>
              <property name="alignment">
               <set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignTop</set>
              </property>
             </widget>
            </item>
           </layout>
          </item>
