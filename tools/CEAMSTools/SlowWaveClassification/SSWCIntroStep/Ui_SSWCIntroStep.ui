               <string>[1] Bouchard, M., Lina, J.-M., Gaudreault, P.-O., Lafrenière, A., Dubé, J., Gosselin, N., &amp;amp; Carrier, J. (2021). Sleeping at the switch. &lt;i&gt;eLife&lt;/i&gt;, &lt;i&gt;10&lt;/i&gt;, Article e64337. &lt;a href="https://doi.org/10.7554/eLife.64337"&gt;https://doi.org/10.7554/eLife.64337&lt;/a&gt;</string>
              </property>
              <property name="textFormat">
               <enum>Qt::TextFormat::RichText</enum>
