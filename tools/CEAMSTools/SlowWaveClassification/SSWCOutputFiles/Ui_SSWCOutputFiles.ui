             <item>
              <widget class="QLabel" name="label_7">
               <property name="text">
                <string>A cohort report, sw_cohort_details_per_categories.tsv, holds the slow wave characteristics averaged per category.</string>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
               <property name="variant" stdset="0">
                <string notr="true">help</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="label_8">
               <property name="text">
                <string>The slow wave characteristics are also given per sleep cycle and per segment of the night.</string>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
               <property name="variant" stdset="0">
                <string notr="true">help</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="label_18">
               <property name="text">
                <string>• Per sleep cycle, only the valid data is counted. The artifacts and the sleep stages not selected for the detection are left out.</string>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
               <property name="variant" stdset="0">
                <string notr="true">help</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="label_17">
               <property name="text">
                <string>• Per segment of the night, all the epochs of the sleep stages file are divided into segments, artifacts included. These are the epochs of the sleep stages selected for the detection, inside the sleep cycles.</string>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
               <property name="variant" stdset="0">
                <string notr="true">help</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QLabel" name="label_11">
