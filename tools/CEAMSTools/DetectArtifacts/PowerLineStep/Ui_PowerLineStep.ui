              <property name="text">
               <string>[1] Cox, R., &amp;amp; Fell, J. (2020). Analyzing human sleep EEG: A methodological primer with code implementation. &lt;i&gt;Sleep Medicine Reviews&lt;/i&gt;, &lt;i&gt;54&lt;/i&gt;, Article 101353. &lt;a href="https://doi.org/10.1016/j.smrv.2020.101353"&gt;https://doi.org/10.1016/j.smrv.2020.101353&lt;/a&gt;</string>
              </property>
              <property name="textFormat">
               <enum>Qt::TextFormat::RichText</enum>
