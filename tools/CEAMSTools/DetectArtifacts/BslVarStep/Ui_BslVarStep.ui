           <item>
            <widget class="QLabel" name="filter_warning_label">
             <property name="text">
              <string>&lt;b&gt;The bandpass filter changes the low frequencies&lt;/b&gt;&lt;br/&gt;The low cutoff of "Filter EEG signals" changes the power below 0.4 Hz. Keep the low frequencies to detect the baseline variations.</string>
             </property>
             <property name="textFormat">
              <enum>Qt::TextFormat::RichText</enum>
