             <item>
              <widget class="QLabel" name="channels_label">
               <property name="text">
                <string>The sleep stages can be scored from a single EEG channel, preferably a central one (C3, C4). One EOG and one EMG channel can improve the accuracy. You can select up to four EEG channels: for each epoch, the most confident classification is kept.</string>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
