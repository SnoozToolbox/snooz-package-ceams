             <item>
              <widget class="QLabel" name="methods_label">
               <property name="text">
                <string>&lt;b&gt;YASA sleep staging [1]:&lt;/b&gt; an open-source algorithm trained on more than 30,000 hours of PSG data from diverse populations.&lt;br/&gt;• &lt;b&gt;Data processing:&lt;/b&gt; a central EEG channel, with the EOG and EMG channels, downsampled to 100 Hz and band-pass filtered between 0.4 and 30 Hz.&lt;br/&gt;• &lt;b&gt;Feature extraction:&lt;/b&gt; time and frequency domain features of the EEG, and optionally of the EOG and EMG, for each 30-second epoch.&lt;br/&gt;• &lt;b&gt;Smoothing and normalization:&lt;/b&gt; the features are smoothed across epochs to include the context, then z-scored over each night.&lt;br/&gt;• &lt;b&gt;Classification:&lt;/b&gt; LightGBM, a tree-based gradient-boosting classifier.&lt;br/&gt;• &lt;b&gt;Performance evaluation:&lt;/b&gt; standardized guidelines, including the accuracy, Cohen's kappa, the Matthews correlation coefficient, confusion matrices and F1-scores.&lt;br/&gt;&lt;br/&gt;Documentation of YASA: &lt;a href="https://raphaelvallat.com/yasa/"&gt;raphaelvallat.com/yasa&lt;/a&gt;.</string>
               </property>
               <property name="textFormat">
                <enum>Qt::TextFormat::RichText</enum>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
               <property name="openExternalLinks">
                <bool>true</bool>
               </property>
               <property name="variant" stdset="0">
                <string notr="true">help</string>
               </property>
              </widget>
