           <widget class="QLabel" name="label_3">
            <property name="text">
             <string>The oximeter measures the percentage of oxygen in the blood. A desaturation is a drop of the oxygen level (%) during a time (s), as shown here; the recovery that follows it is detected with fixed criteria, inspired by ABOSA [1].</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
