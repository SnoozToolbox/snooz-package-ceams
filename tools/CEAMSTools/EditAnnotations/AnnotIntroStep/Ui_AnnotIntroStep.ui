          <item>
           <widget class="QLabel" name="about_editing_label">
            <property name="text">
             <string>&lt;b&gt;Removing and renaming&lt;/b&gt;&lt;br/&gt;To remove annotations, uncheck their group or name. To rename them, edit the label in the "Group‑Name" column.&lt;br/&gt;• In "Events from selection", the changes apply to the recording selected in "PSG Files".&lt;br/&gt;• In "Events from cohort", the changes apply to all the recordings.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Buttons&lt;/b&gt;&lt;br/&gt;• "Refresh" updates "Events from cohort". It merges the edited groups that have the same label and sorts the annotations by their new label.&lt;br/&gt;• "Back to original labels" undoes the changes made since the files were opened.&lt;br/&gt;• "Export" shows all the changes to apply at runtime, in tables you can download as TSV. The annotations to rename come first, then the annotations to remove.</string>
            </property>
            <property name="textFormat">
             <enum>Qt::TextFormat::RichText</enum>
