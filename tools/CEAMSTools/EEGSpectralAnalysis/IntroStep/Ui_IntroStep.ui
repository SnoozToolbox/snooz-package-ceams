                 <property name="frameShadow">
                  <enum>QFrame::Shadow::Plain</enum>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QLabel" name="references_label">
                 <property name="font">
                  <font>
                   <pointsize>10</pointsize>
                  </font>
