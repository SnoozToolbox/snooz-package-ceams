          <item>
           <widget class="QLabel" name="subtitle_label">
            <property name="text">
             <string>Computes the functional connectivity between the EEG channels of your polysomnography (PSG) files with the weighted phase lag index (wPLI), the directed phase lag index (dPLI) or the amplitude envelope correlation (AEC), and the network properties of the wPLI connectivity.</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
            <property name="variant" stdset="0">
             <string notr="true">help</string>
            </property>
