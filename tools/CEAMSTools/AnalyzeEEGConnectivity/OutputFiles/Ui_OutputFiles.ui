            <property name="text">
             <string>About the head connectivity plot</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="about_plot_label">
            <property name="text">
             <string>• &lt;b&gt;Montage:&lt;/b&gt; chosen automatically from the MNE built-in montages with the channel names. For HydroCel 128/129, the face and neck sensors are removed to keep the head outline clean.&lt;br/&gt;• &lt;b&gt;Nodes:&lt;/b&gt; the channels. Unconnected channels in white, connected channels filled in black, with their labels.&lt;br/&gt;• &lt;b&gt;Edges:&lt;/b&gt; the connections above the display thresholds. Their thickness and opacity scale with the strength: thin and faint for a moderate connection, thick and dark for a strong one.&lt;br/&gt;• &lt;b&gt;Colors:&lt;/b&gt; wPLI and AEC (undirected): one hue, darker is stronger. dPLI (directional): each edge fades from the leader (red) through purple to the lagger (blue); colorbar "Bias = dPLI − 0.5".</string>
            </property>
            <property name="textFormat">
             <enum>Qt::TextFormat::RichText</enum>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
            <property name="variant" stdset="0">
             <string notr="true">help</string>
            </property>
